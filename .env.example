# Copy to .env. Do not commit .env — this repo is public.

# MongoDB Atlas Hackathon Sandbox (build must live here for eligibility)
MONGODB_URI=mongodb+srv://<username>:<url-encoded-password>@cluster0.<cluster-id>.mongodb.net/?appName=Cluster0
PERPETUAL_DB=perpetual

# LLM + embeddings (Gemini, OpenAI-compatible endpoints)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
EMBED_PROVIDER=gemini   # gemini | fake (offline dev) | auto (Atlas Automated Embeddings)
EMBED_DIMS=768

# Voice (tool-birth announcement, optional)
ELEVENLABS_API_KEY=

# Force the deterministic offline agent policy (no LLM calls)
# PERPETUAL_MOCK=1
